---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import { sortedPosts, postTags } from '../../utils/posts';

const posts = await sortedPosts();
const counts = new Map<string, number>();
for (const p of posts) {
  for (const tag of postTags(p)) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'),
);
---
<BaseLayout
  title="tags | jay"
  description="태그별 글 모음"
  canonical="https://jayonthegreen.github.io/tags/"
>
  <Nav />
  <h1>Tags</h1>
  <div style="line-height: 2;">
    {tags.map(([tag, count]) => (
      <a href={`/tags/${tag}/`} style="margin-right: 0.8rem; white-space: nowrap; text-decoration: none;">
        #{tag} <span style="font-size: small; color: #888;">{count}</span>
      </a>
    ))}
  </div>
</BaseLayout>
