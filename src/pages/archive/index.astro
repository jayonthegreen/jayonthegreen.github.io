---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import { sortedPosts, postDate, archiveKey } from '../../utils/posts';

const posts = await sortedPosts();
const counts = new Map<string, number>();
for (const p of posts) {
  const key = archiveKey(postDate(p));
  if (!key) continue;
  counts.set(key, (counts.get(key) ?? 0) + 1);
}
const months = [...counts.entries()].sort((a, b) => b[0].localeCompare(a[0]));
---
<BaseLayout
  title="archive | jay"
  description="월별 글 모음"
  canonical="https://jayonthegreen.github.io/archive/"
>
  <Nav />
  <h1>Archive</h1>
  <ul style="padding: 0; margin: 0; list-style: none;">
    {months.map(([key, count]) => (
      <li style="list-style: none; margin: 0.4rem 0;">
        <a href={`/archive/${key}/`} style="text-decoration: none;">
          {key.replace('-', '.')} <span style="font-size: small; color: #888;">{count}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
